{
  "Koşul (eğer)": {
    "prefix": ["eğer", "eger", "if"],
    "body": ["eğer ${1:koşul} ise", "\t$0", "bitir"],
    "description": "eğer … ise … bitir"
  },
  "Koşul + değilse": {
    "prefix": ["eğerd", "egerd", "ifelse"],
    "body": ["eğer ${1:koşul} ise", "\t$2", "değilse", "\t$0", "bitir"],
    "description": "eğer … ise … değilse … bitir"
  },
  "Koşul zinciri": {
    "prefix": ["eğerz", "egerz", "elif"],
    "body": ["eğer ${1:koşul} ise", "\t$2", "değilse eğer ${3:koşul} ise", "\t$4", "değilse", "\t$0", "bitir"],
    "description": "eğer … değilse eğer … değilse … bitir"
  },
  "Sayaç döngüsü": {
    "prefix": ["döngü", "dongu", "for"],
    "body": ["döngü ${1:i} = ${2:1}, ${3:10} için", "\t$0", "bitir"],
    "description": "Sayaç döngüsü (iki uç dahil)"
  },
  "Koşul döngüsü": {
    "prefix": ["döngük", "donguk", "while"],
    "body": ["döngü ${1:koşul} için", "\t$0", "bitir"],
    "description": "Koşul doğru oldukça tekrarlayan döngü"
  },
  "Yazdır": {
    "prefix": ["yazdır", "yazdir", "print"],
    "body": ["yazdır ${1:\"metin\"}"],
    "description": "Ekrana yaz"
  }
}
