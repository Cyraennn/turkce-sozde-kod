{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["\"", "\""]
  ],
  "wordPattern": "[A-Za-z_ÇĞİÖŞÜçğıöşüÂâÎîÛû][A-Za-z0-9_ÇĞİÖŞÜçğıöşüÂâÎîÛû]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:.*\\s(?:ise|için)|değilse)\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:bitir|değilse)(?:\\s|$)"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(?:eğer|döngü)\\s",
      "end": "^\\s*bitir(?:\\s|$)"
    }
  }
}
